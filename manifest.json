{
  "manifest_version": 3,
  "name": "Shopee Reviews Exporter",
  "version": "1.1",
  "description": "Exporta reviews da Shopee para CSV compativel com Judge.me",
  "permissions": ["activeTab", "scripting", "downloads", "tabs", "storage"],
  "host_permissions": ["https://shopee.com.br/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Reviews Exporter"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.com.br/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
